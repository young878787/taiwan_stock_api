# ===== 金鑰（本檔不入版控，測試離線不依賴） =====

# FinMind API Token（可留空，Live 呼叫時再填）
# 申請：https://www.finmindtrade.com/login
FINMIND_TOKEN=

FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4

# FinMind 日K Trading_Volume 單位：shares=股(不乘)、lots=張(×1000)。實測為 股 → 用 shares
FINMIND_VOLUME_UNIT=shares

# TWSE OpenAPI（公開，無需金鑰）
TWSE_BASE_URL=https://www.twse.com.tw

# Shioaji（第二階段才使用，先保留欄位）
SHIOAJI_KEY=
SHIOAJI_SECRET=

# ===== AI（qlab 子專案：Qlib + RD-Agent；與上面共用同一份 .env） =====

# LLM 金鑰：RD-Agent 至少需要一組（OpenAI 或 DeepSeek 擇一）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qlib 資料集 / 實驗輸出位置（預設 <KSTOCK_DATA_DIR>/qlab/...）
QLAB_PROVIDER_DIR=
QLAB_EXPERIMENT_DIR=

# 資料根目錄（預設專案下 data/）
KSTOCK_DATA_DIR=
